{
    "description": "Table containing errors encountered while scraping job offers",
    "partition_field": "created_at",
    "schema": [
        {"name": "id", "type": "STRING", "mode": "REQUIRED", "description": "Unique error identifier"},
        {"name": "error_message", "type": "STRING", "mode": "NULLABLE", "description": "Error message raised during scraping"},
        {"name": "url", "type": "STRING", "mode": "NULLABLE", "description": "URL being scraped when the error occurred"},
        {"name": "created_at", "type": "TIMESTAMP", "mode": "REQUIRED", "description": "Record creation date"}
    ]
}
